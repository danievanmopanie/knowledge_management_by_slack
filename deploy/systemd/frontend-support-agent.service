[Unit]
Description=Standalone Frontend Support Slack Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=danieungerer
WorkingDirectory=/home/danieungerer/knowledge_management_by_slack_frontend_runtime
EnvironmentFile=/home/danieungerer/knowledge_management_by_slack/.env
Environment="VECTORSTORE_PATH=/home/danieungerer/knowledge_management_by_slack/data/vectorstore"
Environment="RAW_DOCS_PATH=/home/danieungerer/knowledge_management_by_slack/data/raw"
Environment="STAGING_PATH=/home/danieungerer/knowledge_management_by_slack/data/staging"
Environment="BACKUP_ROOT=/home/danieungerer/knowledge_management_by_slack/data/backups"
Environment="INCIDENTS_PATH=/home/danieungerer/knowledge_management_by_slack/data/incidents"
Environment="PLATFORM_DB_PATH=/home/danieungerer/knowledge_management_by_slack/data/platform.db"
ExecStart=/home/danieungerer/knowledge_management_by_slack_frontend_runtime/.venv/bin/python -m src.bot.frontend_support_app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
