# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Channel IDs
CHANNEL_FRONTEND_SUPPORT=C0123456789
CHANNEL_INVENTORY=C0123456789
INVENTORY_INTERACTIVE_ALLOWED_USER_IDS=U0123456789
CHANNEL_WORK_MANAGEMENT=C0123456789
CHANNEL_KNOWLEDGE_UPLOADS=C0123456789
# Preferred destination for curated knowledge work created from #frontend-support.
# If omitted, knowledge-gap tasks fall back to CHANNEL_KNOWLEDGE_UPLOADS.
CHANNEL_CREATE_KNOWLEDGE=C0123456789
CHANNEL_BUILDER_AGENT=C0123456789

# Builder Agent – natural on-device engineering harness
BUILDER_AGENT_ALLOWED_USER_IDS=U0123456789
BUILDER_REPO_PATH=./data/builder/repo
BUILDER_WORKDIR=./data/builder/worktrees

# Builder-only inference canary. Atlas serves an OpenAI-compatible endpoint on
# localhost while the rest of the Slack agents stay on their existing models.
BUILDER_AIDER_MODEL=openai/aeon-builder
BUILDER_LLM_MODEL=aeon-builder
BUILDER_LLM_BASE_URL=http://127.0.0.1:8888/v1
BUILDER_LLM_API_KEY=atlas-local
BUILDER_MODEL_CHECKPOINT=AEON-7/Qwen3.8-27B-AEON-ULTIMATE-UNCENSORED-BF16

# Real GX10 terminal/tool loop. Commands run as the builder-worker service
# account with Slack/GitHub/model credentials removed from the child process
# environment. No sudo bypass is provided. docker run/create stays blocked by
# default; docker compose/ps/logs/inspect/exec can work if the account has Docker access.
BUILDER_TERMINAL_ENABLED=true
BUILDER_TERMINAL_MAX_STEPS=16
BUILDER_TERMINAL_COMMAND_TIMEOUT_SECONDS=180
BUILDER_TERMINAL_MAX_COMMAND_TIMEOUT_SECONDS=900
BUILDER_TERMINAL_OUTPUT_CHARS=12000
BUILDER_TERMINAL_MAX_TOKENS=4096
BUILDER_TERMINAL_TEMPERATURE=0.1
BUILDER_TERMINAL_ALLOW_DOCKER_RUN=false

# The worker runs the same high-signal checks as CI in each isolated git
# worktree. It asks AEON to repair failures and refuses to publish while red.
BUILDER_TEST_COMMAND={python} -m ruff check src tests scripts && {python} -m pytest -q
BUILDER_TEST_TIMEOUT_SECONDS=1200
BUILDER_MAX_REPAIR_ATTEMPTS=2
BUILDER_REQUIRE_TESTS_PASS=true
BUILDER_VALIDATION_OUTPUT_CHARS=8000

BUILDER_TASK_TIMEOUT_SECONDS=1800
BUILDER_POLL_INTERVAL_SECONDS=15
BUILDER_GIT_REMOTE=origin
BUILDER_BASE_BRANCH=main

# Security: startup self-check. If this worker process can itself read .env or
# SSH keys, any run_shell subprocess it spawns can too, regardless of what the
# shell command blocklist matches. See docs/BUILDER_ATLAS_AEON.md for the real
# fix (file permissions), which this check only detects, not enforces.
BUILDER_SECRET_CHECK_ENABLED=true
BUILDER_SECRET_CHECK_EXTRA_PATHS=

# Reliability: fail (not silently retry) any turn still 'running' after a
# worker crash/restart, and prune orphaned git worktrees on startup.
BUILDER_STARTUP_RECOVERY_ENABLED=true

# Reliability: overall wall-clock cap for one Slack turn (tool loop + repair +
# validation combined), independent of the per-call timeouts above. Builder is
# a strict single-worker FIFO queue, so a runaway turn without this cap blocks
# every other queued Slack conversation.
BUILDER_TURN_DEADLINE_SECONDS=5400

# UX: live progress detail on the persistent status card, throttled to this
# minimum interval between chat.update calls.
BUILDER_PROGRESS_MIN_INTERVAL_SECONDS=4.0
BUILDER_PROGRESS_DETAIL_MAX_CHARS=200

# Merge & Deploy: one-click Slack button that merges a green PR and restarts
# the named systemd unit(s) on the GX10. This is a deterministic code path,
# never reachable from the AEON tool loop. Leave BUILDER_DEPLOY_RESTART_UNITS
# empty to keep the button hidden until you've verified your real unit
# name(s) and installed deploy/sudoers/builder-deploy.
BUILDER_DEPLOY_RESTART_UNITS=
BUILDER_MERGE_METHOD=squash
BUILDER_DEPLOY_RESTART_TIMEOUT_SECONDS=60
BUILDER_DEPLOY_HEALTH_CHECK_TIMEOUT_SECONDS=20

# The live checkout that must be synced (git fetch + hard reset) to the exact
# merged commit before any unit is restarted — restarting a unit only re-execs
# whatever is already on disk, it does not pull new code. Empty defaults to
# the current process's working directory (matches WorkingDirectory= in
# deploy/systemd/). The sync refuses to run (and skips all restarts) if the
# checkout is dirty or has diverged from the merged branch.
BUILDER_DEPLOY_CHECKOUT_PATH=

# If the process running Merge & Deploy is itself one of the units above
# (e.g. knowledge-management-by-slack.service), name it here so its restart
# is deferred until after the deployment record/Slack card are finalized —
# restarting it any earlier kills this process before it can report a result.
BUILDER_DEPLOY_SELF_UNIT=

# GitHub (pull request creation and external PR handoff for Builder Agent)
GITHUB_TOKEN=ghp_your_token
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=your-repo

# Models on GX10 (Ollama)
# Strong technician-facing conversational model
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:30b-a3b

# Smaller model for batch extraction / graph construction
SUPPORT_EXTRACTION_MODEL=qwen3:4b
SUPPORT_EXTRACTION_TEMPERATURE=0.0
SUPPORT_EXTRACTION_CONCURRENCY=2
SUPPORT_EXTRACTION_MAX_CHARS=12000

# Local voice-note transcription. Install with: pip install -e '.[voice]'
VOICE_NOTES_ENABLED=true
VOICE_TRANSCRIPTION_MODEL=small
VOICE_TRANSCRIPTION_DEVICE=cuda
VOICE_TRANSCRIPTION_COMPUTE_TYPE=float16

EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=

INCIDENT_EMBEDDING_MODEL=bge-m3
INCIDENT_EMBEDDING_DOCUMENT_PREFIX=
INCIDENT_EMBEDDING_QUERY_PREFIX=
INCIDENT_EMBEDDING_BATCH_SIZE=64

# Retrieval quality
RETRIEVAL_MIN_CONFIDENCE=0.30
RETRIEVAL_STRONG_CONFIDENCE=0.55
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2

# Paths
VECTORSTORE_PATH=./data/vectorstore
RAW_DOCS_PATH=./data/raw
STAGING_PATH=./data/staging
BACKUP_ROOT=./data/backups
INCIDENTS_PATH=./data/incidents
PLATFORM_DB_PATH=./data/platform.db

# Upload / ingestion policy
MAX_UPLOAD_BYTES=26214400
STAGING_RETENTION_HOURS=24

# Backup policy
BACKUP_INCLUDE_RAW=true
BACKUP_RETENTION_COUNT=14
BACKUP_LABEL_PREFIX=scheduled

# Reporting
REPORT_DAILY_ENABLED=true
REPORT_AFTERNOON_ENABLED=true
REPORT_WEEKLY_ENABLED=true
REPORT_DAILY_HOURS=24
REPORT_AFTERNOON_HOURS=10
REPORT_AGING_DAYS=3
REPORT_STALE_HOURS=24
REPORT_WEEKLY_LOCATION=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
