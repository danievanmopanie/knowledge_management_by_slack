# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Channel IDs
CHANNEL_FRONTEND_SUPPORT=C0123456789
CHANNEL_INVENTORY=C0123456789
CHANNEL_WORK_MANAGEMENT=C0123456789
CHANNEL_KNOWLEDGE_UPLOADS=C0123456789

# Local LLM (OpenAI-compatible endpoint on GX10)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:30b-a3b

# Embeddings – general knowledge / runbooks
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# Optional prefixes (for models that benefit from asymmetric query/doc prompts)
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=

# Embeddings – incidents (dedicated, stronger retrieval model)
# Recommended on GX10:
#   qwen3-embedding:0.6b   ← default (fast + strong)
#   qwen3-embedding:4b     ← higher quality
#   bge-m3                 ← excellent technical/multilingual
#   mxbai-embed-large      ← strong English short-text
INCIDENT_EMBEDDING_MODEL=qwen3-embedding:0.6b
INCIDENT_EMBEDDING_DOCUMENT_PREFIX=
INCIDENT_EMBEDDING_QUERY_PREFIX=

# Paths
VECTORSTORE_PATH=./data/vectorstore
RAW_DOCS_PATH=./data/raw
BACKUP_ROOT=./data/backups
INCIDENTS_PATH=./data/incidents

# Backup policy
BACKUP_INCLUDE_RAW=true
BACKUP_RETENTION_COUNT=14
BACKUP_LABEL_PREFIX=scheduled

# Reporting
REPORT_DAILY_ENABLED=true
REPORT_WEEKLY_ENABLED=true
REPORT_DAILY_HOURS=24
REPORT_WEEKLY_LOCATION=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
